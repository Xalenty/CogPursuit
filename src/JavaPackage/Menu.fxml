<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="origine" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="JavaPackage.MenuController"
            prefWidth="1200" prefHeight="900"
            style="-fx-padding: 40;">

    <children>

        <!-- Titre en haut -->
        <VBox alignment="TOP_CENTER"
              AnchorPane.topAnchor="120.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <children>
                <Label text="CogPursuit"
                       style="-fx-font-size: 72px; -fx-text-fill: #4a90e2;" />
            </children>
        </VBox>

        <!-- Menu principal (hub) centré -->
        <VBox fx:id="hub"
              alignment="CENTER"
              spacing="40.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <children>
                <GridPane alignment="CENTER" hgap="30" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="200"/>
                        <ColumnConstraints prefWidth="200"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="50"/>
                        <RowConstraints prefHeight="50"/>
                    </rowConstraints>
                    <children>
                        <Button text="Jouer" onAction="#btnPlay" prefWidth="200"
                                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Button text="Options" onAction="#btnOption" prefWidth="200"
                                GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Button text="Classement" onAction="#btnClassement" prefWidth="200"
                                GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Button text="Quitter" onAction="#btnQuitter" prefWidth="200"
                                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Button text="Reprendre" onAction="#btnReprendre" prefWidth="200"
                                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    </children>
                </GridPane>
            </children>
        </VBox>

        <!-- Sélection du mode de jeu -->
        <VBox fx:id="modeJeu" alignment="CENTER"
              spacing="20.0"
              visible="false" disable="true"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              style="-fx-padding: 40;">
            <children>
                <GridPane alignment="CENTER" hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="100"/>
                        <ColumnConstraints prefWidth="100"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints prefHeight="30"/>
                    </rowConstraints>
                    <children>
                        <Button text="Solo" onAction="#solo"
                                GridPane.columnIndex="0" prefWidth="150"/>
                        <Button text="Multijoueur" onAction="#multi"
                                GridPane.columnIndex="1" prefWidth="150"/>
                    </children>
                </GridPane>
            </children>
        </VBox>

    </children>
</AnchorPane>
